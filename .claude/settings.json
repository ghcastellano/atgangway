{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node scripts/*)",
      "Bash(npm test)",
      "Bash(npm run test:responsivo)",
      "Bash(npx next build)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(./.env.local)",
      "Read(./.env.production)"
    ]
  }
}
