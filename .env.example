# ============================================================
# Vessel Supplier — variáveis de ambiente
# Copie para .env.local e preencha com os valores do projeto
# Supabase (Dashboard → Project Settings → API).
# A anon/publishable key é pública por design — a segurança
# vem das políticas RLS do banco.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional — cotação usada só para o "≈ R$" informativo

# URL pública do app (usada em links de e-mail quando não há origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail de contato mostrado no site
NEXT_PUBLIC_CONTACT_EMAIL=ahoy@marinerssupplyco.com

# ---- Stripe (SOMENTE no ambiente da Vercel — nunca commitar) ----
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Segredo do caminho webhook→banco (valor de app_secrets.stripe_confirm_secret):
# desacopla a autorização no banco do signing secret do Stripe.
# STRIPE_CONFIRM_SECRET=...
