{
  "smtp_sender_name": "At Gangway",
  "mailer_subjects_confirmation": "Confirm your email — At Gangway",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"color-scheme\" content=\"dark\">\n<meta name=\"supported-color-schemes\" content=\"dark\">\n<style>:root { color-scheme: dark; supported-color-schemes: dark; }</style>\n</head>\n<body style=\"margin:0;padding:0;background:#01060D\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#01060D;margin:0;padding:0\">\n  <tr><td align=\"center\" style=\"padding:26px 14px 40px\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:520px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\">\n\n      <tr><td style=\"padding:0 4px 16px\">\n        <span style=\"color:#FFB648;font-size:11px;letter-spacing:2.4px;font-weight:700\">⚓ VESSEL SUPPLIER</span>\n        <span style=\"color:#8CA3BC;font-size:11px;letter-spacing:1.4px\"> · SANTOS</span>\n      </td></tr>\n\n      <tr><td style=\"background:#0B1B30;border:1px solid #16304F;border-radius:16px;padding:24px 22px\">\n        <p style=\"margin:0 0 6px;color:#FFB648;font-size:11px;letter-spacing:2px;font-weight:700\">WELCOME ABOARD</p>\n        <h1 style=\"margin:0 0 10px;color:#EAF2FB;font-size:23px;line-height:1.25;font-weight:800\">Welcome aboard, sailor ⚓</h1>\n        <p style=\"margin:0 0 18px;color:#8CA3BC;font-size:14px;line-height:1.55\">Confirm your e-mail to activate your <b style=\"color:#EAF2FB\">At Gangway</b> account — after that, every kit you order rides with your ship's ETA into Santos.</p>\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0\">\n          <tr><td style=\"padding:14px 16px;background:#06121F;border:1px solid #16304F;border-radius:12px\">\n            <p style=\"margin:0 0 4px;color:#EAF2FB;font-size:13.5px;font-weight:700\">One tap and you're aboard.</p>\n            <p style=\"margin:0;color:#8CA3BC;font-size:13px;line-height:1.55\">Pre-order before you dock, pay a 30% deposit, collect at the gangway. If your ship skips Santos, the deposit becomes full credit.</p>\n          </td></tr>\n        </table>\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:22px 0 2px\">\n          <tr><td style=\"border-radius:12px;background:#FFB648\">\n            <a href=\"{{ .SiteURL }}auth/confirm?token_hash={{ .TokenHash }}&type=email&next={{ .RedirectTo }}\" style=\"display:inline-block;padding:13px 22px;color:#06121F;font-size:15px;font-weight:800;text-decoration:none;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\">Confirm my email</a>\n          </td></tr>\n        </table>\n        <p style=\"margin:18px 0 0;padding-top:16px;border-top:1px solid #16304F;color:#8CA3BC;font-size:12px;line-height:1.6\">\n          <span style=\"color:#8CA3BC\">Button not working? Copy this link into your browser:</span><br>\n          <a href=\"{{ .SiteURL }}auth/confirm?token_hash={{ .TokenHash }}&type=email&next={{ .RedirectTo }}\" style=\"color:#FFB648;word-break:break-all;text-decoration:none\">{{ .SiteURL }}auth/confirm?token_hash={{ .TokenHash }}&type=email&next={{ .RedirectTo }}</a>\n        </p>\n      </td></tr>\n\n      <tr><td style=\"padding:18px 6px 0;color:#8CA3BC;font-size:12px;line-height:1.6\">\n        <span style=\"color:#8CA3BC\">At Gangway — Porto de Santos.</span><br>\n        <span style=\"color:#8CA3BC\">Questions? Just reply to this e-mail.</span>\n        <a href=\"https://atgangway.com\" style=\"color:#8CA3BC\">atgangway.com</a>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>\n</body>\n</html>",
  "mailer_subjects_recovery": "Reset your password — At Gangway",
  "mailer_templates_recovery_content": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"color-scheme\" content=\"dark\">\n<meta name=\"supported-color-schemes\" content=\"dark\">\n<style>:root { color-scheme: dark; supported-color-schemes: dark; }</style>\n</head>\n<body style=\"margin:0;padding:0;background:#01060D\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#01060D;margin:0;padding:0\">\n  <tr><td align=\"center\" style=\"padding:26px 14px 40px\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:520px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\">\n\n      <tr><td style=\"padding:0 4px 16px\">\n        <span style=\"color:#FFB648;font-size:11px;letter-spacing:2.4px;font-weight:700\">⚓ VESSEL SUPPLIER</span>\n        <span style=\"color:#8CA3BC;font-size:11px;letter-spacing:1.4px\"> · SANTOS</span>\n      </td></tr>\n\n      <tr><td style=\"background:#0B1B30;border:1px solid #16304F;border-radius:16px;padding:24px 22px\">\n        <p style=\"margin:0 0 6px;color:#FFB648;font-size:11px;letter-spacing:2px;font-weight:700\">PASSWORD RESET</p>\n        <h1 style=\"margin:0 0 10px;color:#EAF2FB;font-size:23px;line-height:1.25;font-weight:800\">Reset your password</h1>\n        <p style=\"margin:0 0 18px;color:#8CA3BC;font-size:14px;line-height:1.55\">Happens at sea. Tap below to set a new password for your <b style=\"color:#EAF2FB\">At Gangway</b> account. The link works once and expires soon.</p>\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0\">\n          <tr><td style=\"padding:14px 16px;background:#06121F;border:1px solid #16304F;border-radius:12px\">\n            <p style=\"margin:0 0 4px;color:#EAF2FB;font-size:13.5px;font-weight:700\">Didn't ask for this?</p>\n            <p style=\"margin:0;color:#8CA3BC;font-size:13px;line-height:1.55\">Then ignore this e-mail — your password stays exactly as it is, and the link below dies on its own.</p>\n          </td></tr>\n        </table>\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:22px 0 2px\">\n          <tr><td style=\"border-radius:12px;background:#FFB648\">\n            <a href=\"{{ .SiteURL }}auth/confirm?token_hash={{ .TokenHash }}&type=recovery&next=/reset-password\" style=\"display:inline-block;padding:13px 22px;color:#06121F;font-size:15px;font-weight:800;text-decoration:none;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\">Reset my password</a>\n          </td></tr>\n        </table>\n        <p style=\"margin:18px 0 0;padding-top:16px;border-top:1px solid #16304F;color:#8CA3BC;font-size:12px;line-height:1.6\">\n          <span style=\"color:#8CA3BC\">Button not working? Copy this link into your browser:</span><br>\n          <a href=\"{{ .SiteURL }}auth/confirm?token_hash={{ .TokenHash }}&type=recovery&next=/reset-password\" style=\"color:#FFB648;word-break:break-all;text-decoration:none\">{{ .SiteURL }}auth/confirm?token_hash={{ .TokenHash }}&type=recovery&next=/reset-password</a>\n        </p>\n      </td></tr>\n\n      <tr><td style=\"padding:18px 6px 0;color:#8CA3BC;font-size:12px;line-height:1.6\">\n        <span style=\"color:#8CA3BC\">At Gangway — Porto de Santos.</span><br>\n        <span style=\"color:#8CA3BC\">Questions? Just reply to this e-mail.</span>\n        <a href=\"https://atgangway.com\" style=\"color:#8CA3BC\">atgangway.com</a>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>\n</body>\n</html>"
}
